# One or more HTTP(S) sources, separated by literal newlines.
# Only configure sources whose terms permit your intended use.
SOURCE_URLS=https://example.org/permissively-licensed-list.txt
# Alternatively, mount and select a validated TOML manifest.
# SOURCES_FILE=/app/config/sources.toml
# Optional processing configuration mounted by Docker Compose.
# CONFIG_FILE=/app/config/config.toml
# find | remove_single_ips | remove_ranges
OVERLAP_ACTION=find
HTTP_TIMEOUT=60
MAX_DOWNLOAD_BYTES=52428800
MAX_ZIP_MEMBERS=1000
MAX_ZIP_MEMBER_BYTES=26214400
MAX_ZIP_TOTAL_BYTES=104857600
MAX_ZIP_COMPRESSION_RATIO=100
# Only enable this for source URLs on a network you trust.
ALLOW_PRIVATE_SOURCES=false
